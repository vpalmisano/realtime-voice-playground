    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@cartesia/cartesia-js": "^4.2.0",
