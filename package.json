{
  "name": "realtime-voice-playground",
  "private": true,
  "version": "0.0.1",
  "title": "Realtime Voice Playground",
  "description": "An interactive webapp for trying voice AI — end-to-end realtime models (OpenAI, Google, ElevenLabs, Inworld) or a custom STT (ElevenLabs, Google, Gradium, Mistral, Nvidia, OpenAI) → LLM (Anthropic, Google, Nvidia, OpenAI) → TTS (Cartesia, ElevenLabs, Google, Gradium, Gradium Phonon, OpenAI, Speechify) pipeline.",
  "keywords": [
    "voice",
    "ai",
    "realtime",
    "models",
    "openai",
    "google",
    "elevenlabs",
    "inworld"
  ],
  "author": "Vittorio Palmisano",
  "url": "https://vpalmisano.github.io/realtime-voice-playground",
  "repository": {
    "type": "git",
    "url": "https://github.com/vpalmisano/realtime-voice-playground.git"
  },
  "homepage": "https://vpalmisano.github.io/realtime-voice-playground",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "npm run lint && npm run format && vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
