    "awaitqueue": "^3.3.1",
    "chart.js": "^4.6.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "hammerjs": "^2.0.8",
